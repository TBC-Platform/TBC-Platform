# SPDX-License-Identifier: MIT
# Copy to `.env` (which is git-ignored) and edit. Every value here is a
# default you can also set as a real environment variable.

# --------------------------------------------------------------------------
# Server
# --------------------------------------------------------------------------
WALLE_HOST=0.0.0.0
WALLE_PORT=8765
WALLE_LOG_LEVEL=INFO

# REQUIRED. Must match WALLE_AUTH_TOKEN in firmware/include/secrets.h.
# Generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WALLE_AUTH_TOKEN=

# --------------------------------------------------------------------------
# Speech to text
# --------------------------------------------------------------------------
WALLE_STT_BACKEND=whispercpp
WALLE_WHISPER_BIN=whisper-cli
WALLE_WHISPER_MODEL=models/ggml-base.en-q5_1.bin
WALLE_STT_LANGUAGE=en
WALLE_STT_THREADS=4
# 1 = greedy. Anything higher trades latency for a tiny accuracy gain.
WALLE_STT_BEAM=1
# Bias the recogniser towards words it will actually hear. Worth setting to
# the names of your rooms, pets and smart home devices.
WALLE_STT_PROMPT=Wall-E, robot, desk lamp, office light, kitchen, living room.

# --------------------------------------------------------------------------
# Text to speech
# --------------------------------------------------------------------------
WALLE_TTS_BACKEND=piper
WALLE_PIPER_BIN=piper
WALLE_PIPER_MODEL=models/en_US-lessac-medium.onnx
WALLE_TTS_LENGTH_SCALE=1.05
# 0.0 = plain human voice, 1.0 = full robot. Above ~0.5 it gets hard to follow.
WALLE_TTS_ROBOT=0.35

# --------------------------------------------------------------------------
# Language model
# --------------------------------------------------------------------------
# 'ollama' keeps everything on your machine. 'openai' sends the transcribed
# text (never audio, never images) to the cloud.
WALLE_LLM_BACKEND=ollama
WALLE_LLM_MODEL=llama3.2:3b
WALLE_OLLAMA_URL=http://127.0.0.1:11434
WALLE_LLM_MAX_TOKENS=160
WALLE_LLM_HISTORY_TURNS=8

# Only used when WALLE_LLM_BACKEND=openai
# OPENAI_API_KEY=
# WALLE_OPENAI_MODEL=gpt-4o-mini

# --------------------------------------------------------------------------
# Vision
# --------------------------------------------------------------------------
WALLE_VISION_ENABLED=1
WALLE_VISION_BACKEND=tflite
WALLE_VISION_MODEL=models/ssd_mobilenet_v1.tflite
WALLE_VISION_LABELS=models/coco_labels.txt
WALLE_VISION_MIN_SCORE=0.45

# --------------------------------------------------------------------------
# Smart home  (off by default - read docs/06-smart-home-security.md first)
# --------------------------------------------------------------------------
WALLE_SMARTHOME_ENABLED=0
WALLE_SMARTHOME_BACKEND=homeassistant
WALLE_HA_URL=http://homeassistant.local:8123
# Long-lived token from a DEDICATED NON-ADMIN Home Assistant user.
WALLE_HA_TOKEN=

# The allowlist. Nothing outside this list can ever be controlled.
# Comma separated entity ids; globs like light.office_* work but widen scope.
WALLE_ALLOWED_ENTITIES=light.desk_lamp,light.office_ceiling
WALLE_ALLOWED_DOMAINS=light,switch,fan,scene,media_player
